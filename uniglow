        if laptop and laptop.found:
            self.sys_box, self.page_lp = self._add_page(
                "laptop", self.t["page_laptop"], "computer-symbolic")
            header.set_title_widget(Adw.ViewSwitcher(
                stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
            # sensors are polled only while this page is on screen
            self.win.connect("map", self._update_polling)
            self.win.connect("unmap", self._update_polling)
            self.win.connect("realize", self._on_realize)
            self.stack.connect("notify::visible-child-name",
                               self._update_polling)

        self._build_menu()
        if not bl.found:
            self._build_missing()
        else:
            self._build_controls()
        if self.sys_box:
            self._build_laptop()
            if not bl.found:
                self.stack.set_visible_child_name("laptop")
        self._building = False
        self._sync_ui()

    def _add_page(self, name, title, icon):
        Adw, Gtk = self.Adw, self.Gtk
        clamp = Adw.Clamp(maximum_size=420, margin_top=10, margin_bottom=18,
                          margin_start=14, margin_end=14)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        clamp.set_child(box)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(clamp)
        page = self.stack.add_titled_with_icon(scroll, name, title, icon)
        return box, page

    # ---------- UI construction ----------

    def _build_missing(self):
        page = self.Adw.StatusPage(
            icon_name="input-keyboard-symbolic",
            title=self.t["app"], description=self.t["no_device"])
        self.box.append(page)

    def _build_controls(self):
        Adw, Gtk = self.Adw, self.Gtk
        t, cfg = self.t, self.cfg

        # live preview canvas — instant feedback while the slow EC catches up
        self.hero = Gtk.DrawingArea(content_height=130)
        self.hero.add_css_class("uniglow-hero")
        self.hero.add_css_class("card")
        self.hero.set_draw_func(self._draw_hero)
        self.box.append(self.hero)

        # power + brightness
        g1 = Adw.PreferencesGroup()
        self.sw_power = Adw.SwitchRow(title=t["power"])
        self.sw_power.set_active(cfg["on"])
        self.sw_power.connect("notify::active", self._changed)
        g1.add(self.sw_power)

        row_b = Adw.ActionRow(title=t["brightness"])
        self.br_toggles = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        for i in range(1, self.bl.max_brightness + 1):
            self.br_toggles.add(Adw.Toggle(name=str(i), label=str(i)))
        self.br_toggles.set_active_name(
            str(max(1, min(self.bl.max_brightness, cfg["brightness"]))))
        self.br_toggles.connect("notify::active-name", self._changed)
        row_b.add_suffix(self.br_toggles)
        g1.add(row_b)
        self.box.append(g1)

        # color
        if self.bl.is_rgb:
            g2 = Adw.PreferencesGroup(title=t["color"])
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                               max_children_per_line=5, min_children_per_line=5,
                               row_spacing=10, column_spacing=10,
                               margin_top=8, margin_bottom=4, homogeneous=True)
            self._preset_btns = {}
            for i, c in enumerate(PRESETS):
                b = Gtk.Button(halign=Gtk.Align.CENTER)
                b.add_css_class("uniglow-swatch")
                b.add_css_class("uniglow-sw-%d" % i)
                b.connect("clicked", self._preset_clicked, c)
                self._preset_btns[c] = b
                flow.append(b)
            g2.add(flow)

            row_c = Adw.ActionRow(title=t["custom_color"])
            self.color_btn = Gtk.ColorDialogButton(
                dialog=Gtk.ColorDialog(with_alpha=False))
            rgba = self.Gdk.RGBA()
            rgba.parse(cfg["color"])
            self.color_btn.set_rgba(rgba)
            self.color_btn.set_valign(Gtk.Align.CENTER)
            self.color_btn.connect("notify::rgba", self._custom_color)
            row_c.add_suffix(self.color_btn)
            g2.add(row_c)
            self.box.append(g2)
            self.grp_color = g2

            # mode + speed
            g3 = Adw.PreferencesGroup(title=t["mode"])
            self.toggles = Adw.ToggleGroup(margin_top=4, margin_bottom=4)
            for name in ("static", "breathing", "rainbow"):
                self.toggles.add(Adw.Toggle(name=name, label=t[name]))
            self.toggles.set_active_name(cfg["mode"])
            self.toggles.connect("notify::active-name", self._changed)
            g3.add(self.toggles)

            self.row_speed = Adw.ActionRow(title=t["speed"])
            self.sc_speed = Gtk.Scale.new_with_range(
                Gtk.Orientation.HORIZONTAL, 1, 10, 1)
            self.sc_speed.set_size_request(180, -1)
            self.sc_speed.set_hexpand(True)
            self.sc_speed.set_valign(Gtk.Align.CENTER)
            self.sc_speed.set_draw_value(False)
            self.sc_speed.set_value(cfg["speed"])
            self.sc_speed.connect("value-changed", self._changed)
            self.row_speed.add_suffix(self.sc_speed)
            g3.add(self.row_speed)
            self.box.append(g3)
            self.grp_mode = g3

    def _sensor_title(self, label, fallback_key, i):
        key = "s_%s" % label
        return self.t[key] if key in self.t else (label or self.t[fallback_key] % i)

    def _build_laptop(self):
        Adw, Gtk = self.Adw, self.Gtk
        t, lp = self.t, self.laptop

        # sensors: read-only, filled by the poller
        self.sensor_labels = {}
        if lp.has_sensors:
            g = Adw.PreferencesGroup(title=t["sensors"])
            for kind, items in (("t", lp.temps), ("f", lp.fans)):
                for item in items:
                    i, label = item[0], item[1]
                    row = Adw.ActionRow(title=self._sensor_title(
                        label, "temp_n" if kind == "t" else "fan_n", i))
                    val = Gtk.Label(label="—", valign=Gtk.Align.CENTER)
                    val.add_css_class("numeric")
                    row.add_suffix(val)
                    g.add(row)
                    self.sensor_labels[(kind, i)] = val
            self.sys_box.append(g)

        # charging mode
        self.charge_toggles = None
        self._charge_modes = []
        if lp.charge:
            try:
                self._charge_modes, cur = lp.read_charge()
            except OSError:
                cur = None
            if self._charge_modes:
                g = Adw.PreferencesGroup(title=t["charging"])
                self.charge_toggles = Adw.ToggleGroup(margin_top=4,
                                                      margin_bottom=4)
                for m in self._charge_modes:
                    self.charge_toggles.add(Adw.Toggle(name=m,
                                                       label=t["ch_" + m]))
                g.add(self.charge_toggles)
                self.grp_charge = g
                self._show_charge(cur)
                self.charge_toggles.connect("notify::active-name",
                                            self._charge_changed)
                self.sys_box.append(g)

        # keyboard locks
        self.sw_fn = self.sw_super = None
        rows = []
        if lp.fn_lock:
            self.sw_fn = Adw.SwitchRow(title=t["fn_lock"],
                                       subtitle=t["fn_lock_sub"])
            self.sw_fn.connect("notify::active", self._fn_changed)
            rows.append(self.sw_fn)
        if lp.super_key:
            self.sw_super = Adw.SwitchRow(title=t["super_lock"],
                                          subtitle=t["super_lock_sub"])
            self.sw_super.connect("notify::active", self._super_changed)
            rows.append(self.sw_super)
        if rows:
            g = Adw.PreferencesGroup(title=t["keyboard"])
            for r in rows:
                g.add(r)
            self.sys_box.append(g)
        for p in (lp.fn_lock, lp.super_key):
            if p:
                try:
                    self._apply_control(p, read_sysfs(p))
                except OSError:
                    pass
        if self._last_data:
            self._on_data(self._last_data, controls=False)

    def _build_menu(self):
        Gio = self.Gio
        menu = Gio.Menu()
        lang_menu = Gio.Menu()
        for code, label in (("auto", self.t["lang_auto"]),
                            ("en", "English"), ("ru", "Русский")):
            item = Gio.MenuItem.new(label, "app.lang")
            item.set_action_and_target_value(
                "app.lang", self.GLib.Variant.new_string(code))
            lang_menu.append_item(item)
        menu.append_submenu(self.t["language"], lang_menu)
        menu.append(self.t["autostart"], "app.autostart")
        menu.append(self.t["about"], "app.about")
        self.menu_btn.set_menu_model(menu)

        if self.app.lookup_action("lang"):
            return  # actions survive a language rebuild
        a_lang = Gio.SimpleAction.new_stateful(
            "lang", self.GLib.VariantType.new("s"),
            self.GLib.Variant.new_string(self.cfg.get("lang", "auto")))
        a_lang.connect("activate", self._set_lang)
        self.app.add_action(a_lang)

        a_auto = Gio.SimpleAction.new_stateful(
            "autostart", None, self.GLib.Variant.new_boolean(autostart_enabled()))
        a_auto.connect("activate", self._toggle_autostart)
        self.app.add_action(a_auto)

        a_about = Gio.SimpleAction.new("about", None)
        a_about.connect("activate", self._about)
        self.app.add_action(a_about)

    # ---------- live preview ----------

    def _preview_rgb(self):
        if not self.cfg["on"]:
            return (0, 0, 0)
        if is_animated(self.cfg, self.bl.is_rgb):
            return effect_rgb(self.cfg, time.monotonic() - self._t0)
        return hex_to_rgb(self.cfg["color"]) if self.bl.is_rgb else (255, 255, 255)

    def _draw_hero(self, area, cr, w, h):
        def rounded(x, y, rw, rh, r):
            cr.new_sub_path()
            cr.arc(x + rw - r, y + r, r, -math.pi / 2, 0)
            cr.arc(x + rw - r, y + rh - r, r, 0, math.pi / 2)
            cr.arc(x + r, y + rh - r, r, math.pi / 2, math.pi)
            cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
            cr.close_path()

        rgb = self._preview_rgb()
        k = (self.cfg["brightness"] / self.bl.max_brightness) if self.cfg["on"] else 0
        cr_r, cr_g, cr_b = (c / 255 for c in rgb)

        rounded(0, 0, w, h, 16)
        cr.set_source_rgb(0.09, 0.08, 0.12)
        cr.fill()

        # glow halo under the keyboard
        if k > 0:
            for i, a in ((26, 0.10), (18, 0.16), (10, 0.26)):
                rounded(24 - i / 2, h - 34 - i / 2, w - 48 + i, 12 + i, 8 + i / 2)
                cr.set_source_rgba(cr_r, cr_g, cr_b, a * k)
                cr.fill()
            rounded(24, h - 34, w - 48, 10, 5)
            cr.set_source_rgba(cr_r, cr_g, cr_b, 0.55 + 0.45 * k)
            cr.fill()

        # key caps, tinted by the backlight
        rows = ((24, 5), (44, 6), (64, 4))
        for y, n in rows:
            gap = 8
            kw = (w - 48 - gap * (n - 1)) / n
            for j in range(n):
                rounded(24 + j * (kw + gap), y, kw, 14, 4)
                base = 0.16
                cr.set_source_rgb(base + cr_r * 0.5 * k,
                                  base + cr_g * 0.5 * k,
                                  base + cr_b * 0.5 * k)
                cr.fill()

    # ---------- handlers ----------

    def _collect(self):
        cfg = self.cfg
        cfg["on"] = self.sw_power.get_active()
        cfg["brightness"] = int(self.br_toggles.get_active_name() or "1")
        if self.bl.is_rgb:
            cfg["mode"] = self.toggles.get_active_name() or "static"
            cfg["speed"] = int(self.sc_speed.get_value())
        return cfg

    def _changed(self, *args):
        if self._building:
            return
        cfg = self._collect()
        self.writer.update(cfg)     # never blocks; EC catches up in background
        self._save_soon()
        self._sync_ui()

    def _save_soon(self):
        if self._save_timer:
            self.GLib.source_remove(self._save_timer)

        def do_save():
            self._save_timer = None
            save_config(self.cfg)
            return False

        self._save_timer = self.GLib.timeout_add(400, do_save)

    def _preset_clicked(self, _btn, color):
        rgba = self.Gdk.RGBA()
        rgba.parse(color)
        self.color_btn.set_rgba(rgba)  # triggers _custom_color

    def _custom_color(self, *args):
        if self._building:
            return
        rgba = self.color_btn.get_rgba()
        self.cfg["color"] = rgb_to_hex(
            int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255))
        self._changed()

    def _sync_ui(self):
        if not self.bl.found:
            return
        on = self.sw_power.get_active()
        self.br_toggles.set_sensitive(on)
        self.hero.queue_draw()
        if self.bl.is_rgb:
            self.grp_color.set_sensitive(on)
            self.grp_mode.set_sensitive(on)
            mode = self.toggles.get_active_name() or "static"
            self.row_speed.set_visible(mode != "static")
            for c, b in self._preset_btns.items():
                if c == self.cfg["color"] and on:
                    b.add_css_class("uniglow-active")
                else:
                    b.remove_css_class("uniglow-active")
        # animate the preview while an effect runs
        animated = is_animated(self.cfg, self.bl.is_rgb)
        if animated and self._hero_timer is None:
            self._hero_timer = self.GLib.timeout_add(90, self._hero_tick)
        elif not animated and self._hero_timer is not None:
            self.GLib.source_remove(self._hero_timer)
            self._hero_timer = None

    def _hero_tick(self):
        self.hero.queue_draw()
        return True

    # ---------- laptop page ----------

    def _show_charge(self, mode):
        if self.charge_toggles and mode in self._charge_modes:
            self.charge_toggles.set_active_name(mode)
            self.grp_charge.set_description(self.t["chd_" + mode])

    def _apply_control(self, path, value):
        """Reflect a value read from sysfs without triggering a write."""
        lp = self.laptop
        prev, self._building = self._building, True
        try:
            if path == lp.charge:
                self._show_charge(parse_charge_types(value)[1])
            elif path == lp.fn_lock and self.sw_fn:
                self.sw_fn.set_active(value == "1")
            elif path == lp.super_key and self.sw_super:
                self.sw_super.set_active(value == "0")
        finally:
            self._building = prev

    def _charge_changed(self, *args):
        if self._building:
            return
        mode = self.charge_toggles.get_active_name()
        if mode:
            self.grp_charge.set_description(self.t["chd_" + mode])
            self.attrw.write(self.laptop.charge, mode)

    def _fn_changed(self, row, _pspec):
        if not self._building:
            self.attrw.write(self.laptop.fn_lock,
                             "1" if row.get_active() else "0")

    def _super_changed(self, row, _pspec):
        # the switch *locks* the key, the driver attribute *enables* it
        if not self._building:
            self.attrw.write(self.laptop.super_key,
                             "0" if row.get_active() else "1")

    def _on_attr_done(self, path, value, err):
        if err is not None:
            if isinstance(err, PermissionError):
                self._perm_hint()
            else:
                self.toast.add_toast(self.Adw.Toast(
                    title=self.t["write_failed"] % (err.strerror or err),
                    timeout=6))
            try:  # put the widget back to what the device really has
                self._apply_control(path, read_sysfs(path))
            except OSError:
                pass
        return False

    def _on_data(self, data, controls=True):
        self._last_data = data
        for i, v in data["temps"].items():
            lbl = self.sensor_labels.get(("t", i))
            if lbl:
                lbl.set_label("—" if v is None else "%d °C" % round(v))
        for i, (rpm, duty) in data["fans"].items():
            lbl = self.sensor_labels.get(("f", i))
            if lbl is None:
                continue
            if rpm is None:
                lbl.set_label("—")
                continue
            text = "%d %s" % (rpm, self.t["rpm"])
            if duty is not None:
                text = '<span alpha="55%%">%d %%</span>    %s' % (duty, text)
            lbl.set_markup(text)
        if controls and self.attrw:
            gens, busy = self.attrw.state()
            for p, v in data["controls"].items():
                # drop values read while a write to the same attribute ran
                if p not in busy and gens.get(p, 0) == data["gens"].get(p, 0):
                    self._apply_control(p, v)
        return False

    def _on_realize(self, win):
        surface = win.get_surface()
        if surface is not None:
            surface.connect("notify::state", self._update_polling)

    def _update_polling(self, *args):
        if not self.poller:
            return
        Gdk = self.Gdk
        visible = self.win.get_mapped()
        surface = self.win.get_surface()
        if visible and isinstance(surface, Gdk.Toplevel):
            hidden = Gdk.ToplevelState.MINIMIZED | getattr(
                Gdk.ToplevelState, "SUSPENDED", 0)
            visible = not (surface.get_state() & hidden)
        self.poller.set_active(
            bool(visible) and self.stack.get_visible_child_name() == "laptop")

    def _perm_hint(self):
        toast = self.Adw.Toast(title=self.t["no_perm"], timeout=6)
        self.toast.add_toast(toast)

    def _set_lang(self, action, value):
        action.set_state(value)
        self.cfg["lang"] = value.get_string()
        save_config(self.cfg)
        self.t = STRINGS[pick_lang(self.cfg)]
        for box in (self.box, self.sys_box):
            while box is not None and (child := box.get_first_child()):
                box.remove(child)
        self._building = True
        self._build_menu()
        if self.bl.found:
            self._build_controls()
        else:
            self._build_missing()
        self.page_bl.set_title(self.t["page_backlight"])
        if self.sys_box:
            self.page_lp.set_title(self.t["page_laptop"])
            self._build_laptop()
        self._building = False
        self._sync_ui()
        self.win.set_title(self.t["app"])

    def _toggle_autostart(self, action, _p):
        new = not action.get_state().get_boolean()
        set_autostart(new)
        action.set_state(self.GLib.Variant.new_boolean(new))

    def _about(self, *args):
        about = self.Adw.AboutDialog(
            application_name="UniGlow",
            application_icon=APP_ID,
            version=VERSION,
            developer_name="CloudWells",
            license_type=self.Gtk.License.MIT_X11,
            website="https://github.com/CloudWells/uniglow",
            comments=self.t["comment"])
        about.present(self.win)

    def _on_close(self, *args):
        if self.poller:
            self.poller.set_active(False)
        # keep an animated mode running after the window closes
        if self._save_timer:
            self.GLib.source_remove(self._save_timer)
            self._save_timer = None
            save_config(self.cfg)
        if self.bl.found and is_animated(self.cfg, self.bl.is_rgb):
            subprocess.Popen([sys.argv[0], "--apply"], start_new_session=True)
        return False


def run_gui():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib
    kill_stray_apply()
    cfg = load_config()
    bl = Backlight()
    laptop = Laptop()
    state = {}

    def perm_error():
        GLib.idle_add(lambda: state["w"]._perm_hint() if "w" in state else False)

    def attr_done(path, value, err):
        GLib.idle_add(lambda: state["w"]._on_attr_done(path, value, err)
                      if "w" in state else False)

    def sensor_data(data):
        GLib.idle_add(lambda: state["w"]._on_data(data)
                      if "w" in state else False)

    writer = Writer(bl, on_perm_error=perm_error)
    if bl.found:
        writer.start()
    attrw = poller = None
    if laptop.found:
        attrw = AttrWriter(on_done=attr_done)
        poller = Poller(laptop, attrw, sensor_data)
        attrw.start()
        poller.start()

    app = Adw.Application(application_id=APP_ID)

    def on_activate(a):
        for w in a.get_windows():
            w.present()
            return
        win = Window(a, cfg, bl, writer, laptop, attrw, poller)
        state["w"] = win
        if bl.found:
            writer.update(cfg)
        win.win.present()

    app.connect("activate", on_activate)
    app.run([])


def main():
    if "--version" in sys.argv:
        print("uniglow", VERSION)
        return
    if "--apply" in sys.argv:
        run_apply()
        return
    run_gui()


if __name__ == "__main__":
    main()
