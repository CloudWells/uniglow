def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_PATH) as f:
            cfg.update(json.load(f))
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def pick_lang(cfg):
    if cfg.get("lang") in ("en", "ru"):
        return cfg["lang"]
    loc = (locale.getlocale()[0] or os.environ.get("LANG", "") or "")
    return "ru" if loc.lower().startswith("ru") else "en"


def hex_to_rgb(s):
    s = s.lstrip("#")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(r, g, b):
    return "#%02X%02X%02X" % (r, g, b)


def effect_rgb(cfg, t):
    """Ideal effect color at time t (shared by device writer and UI preview)."""
    base = hex_to_rgb(cfg["color"])
    mode, speed = cfg["mode"], cfg["speed"]
    if mode == "breathing":
        period = 6.5 - speed * 0.45          # 6.05s .. 2.0s
        k = (1 - math.cos(2 * math.pi * t / period)) / 2
        k = 0.08 + 0.92 * k
        return tuple(int(c * k) for c in base)
    if mode == "rainbow":
        rate = 0.02 + speed * 0.02           # revolutions per second
        return tuple(int(c * 255)
                     for c in colorsys.hsv_to_rgb((t * rate) % 1.0, 1.0, 1.0))
    return base


def is_animated(cfg, is_rgb):
    return bool(cfg["on"]) and cfg["mode"] in ("breathing", "rainbow") and is_rgb


class Backlight:
    """sysfs LED device with logind fallback for brightness."""

    def __init__(self):
        self.path = None
        self.name = None
        self.is_rgb = False
        for name in LED_CANDIDATES:
            p = os.path.join("/sys/class/leds", name)
            if os.path.isdir(p):
                self.path = p
                self.name = name
                self.is_rgb = name.startswith("rgb:")
                break
        self.max_brightness = 1
        if self.path:
            with open(os.path.join(self.path, "max_brightness")) as f:
                self.max_brightness = int(f.read().strip())

    @property
    def found(self):
        return self.path is not None

    def _write(self, attr, value):
        with open(os.path.join(self.path, attr), "w") as f:
            f.write(value)

    def set_brightness(self, value):
        value = max(0, min(self.max_brightness, int(value)))
        try:
            self._write("brightness", str(value))
        except PermissionError:
            # logind grants the active session brightness control without root
            subprocess.run(
                ["busctl", "call", "org.freedesktop.login1",
                 "/org/freedesktop/login1/session/auto",
                 "org.freedesktop.login1.Session", "SetBrightness",
                 "ssu", "leds", self.name, str(value)],
                check=False, capture_output=True)

    def set_color(self, r, g, b):
        # raises PermissionError for the caller to surface a hint
        if self.is_rgb:
            self._write("multi_intensity", "%d %d %d" % (r, g, b))


class Writer(threading.Thread):
    """Owns all EC writes. Coalesces to the newest state; runs effect frames.

    UI threads call update(cfg) and never block. One EC write is ~450 ms, so
    intermediate states (slider drags, rapid clicks) are skipped naturally.
    """

    FRAME_GAP = 0.15  # pause between effect frames on top of the write itself

    def __init__(self, backlight, on_perm_error=None):
        super().__init__(daemon=True)
        self.bl = backlight
        self.on_perm_error = on_perm_error
        self.cond = threading.Condition()
        self.cfg = None
        self.dirty = False
        self.running = True
        self.t0 = time.monotonic()
        self._last_brightness = None
        self._last_color = None
        self._perm_reported = False

    def update(self, cfg):
        with self.cond:
            self.cfg = dict(cfg)
            self.dirty = True
            self.cond.notify()

    def stop(self):
        with self.cond:
            self.running = False
            self.cond.notify()

    def _set_brightness(self, v):
        if v != self._last_brightness:
            self.bl.set_brightness(v)
            self._last_brightness = v

    def _set_color(self, rgb):
        if rgb != self._last_color:
            self.bl.set_color(*rgb)
            self._last_color = rgb

    def sync_once(self, cfg):
        """Apply non-animated parts of cfg (blocking; used headless too)."""
        if not cfg["on"]:
            self._set_brightness(0)
            return
        self._set_brightness(cfg["brightness"])
        if self.bl.is_rgb and cfg["mode"] == "static":
            self._set_color(hex_to_rgb(cfg["color"]))

    def run(self):
        while True:
            with self.cond:
                while self.running and not self.dirty and \
                        not (self.cfg and is_animated(self.cfg, self.bl.is_rgb)):
                    self.cond.wait()
                if not self.running:
                    return
                cfg = dict(self.cfg)
                self.dirty = False
            try:
                self.sync_once(cfg)
                if is_animated(cfg, self.bl.is_rgb):
                    rgb = effect_rgb(cfg, time.monotonic() - self.t0)
                    self._set_color(rgb)
                    time.sleep(self.FRAME_GAP)
            except PermissionError:
                if not self._perm_reported:
                    self._perm_reported = True
                    if self.on_perm_error:
                        self.on_perm_error()
                time.sleep(1)
            except OSError:
                time.sleep(1)


def autostart_enabled():
    return os.path.exists(AUTOSTART_PATH)


def set_autostart(enabled):
    if enabled:
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        with open(AUTOSTART_PATH, "w") as f:
            f.write("[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=UniGlow (restore backlight)\n"
                    "Exec=uniglow --apply\n"
                    "X-GNOME-Autostart-enabled=true\n")
    else:
        try:
            os.remove(AUTOSTART_PATH)
        except OSError:
            pass


def run_apply():
    """Headless: apply saved state; stay resident only for animated modes."""
    cfg = load_config()
    bl = Backlight()
    if not bl.found:
        sys.exit(1)
    writer = Writer(bl)
    if not is_animated(cfg, bl.is_rgb):
        try:
            writer.sync_once(cfg)
        except OSError as e:
            print(e, file=sys.stderr)
            sys.exit(1)
        return
    from gi.repository import GLib
    writer.start()
    writer.update(cfg)
    loop = GLib.MainLoop()
    for s in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, s, loop.quit)
    loop.run()


def kill_stray_apply():
    # a resident `--apply` effect process would fight the GUI over the EC
    me = os.getpid()
    out = subprocess.run(["pgrep", "-f", "uniglow --apply"],
                         capture_output=True, text=True).stdout.split()
    for pid in out:
        if pid.isdigit() and int(pid) != me:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass


