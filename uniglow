def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_PATH) as f:
            cfg.update(json.load(f))
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def pick_lang(cfg):
    if cfg.get("lang") in ("en", "ru"):
        return cfg["lang"]
    loc = (locale.getlocale()[0] or os.environ.get("LANG", "") or "")
    return "ru" if loc.lower().startswith("ru") else "en"


def hex_to_rgb(s):
    s = s.lstrip("#")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(r, g, b):
    return "#%02X%02X%02X" % (r, g, b)


def read_sysfs(path):
    with open(path) as f:
        return f.read().strip()


def parse_charge_types(text):
    """'Trickle [Standard] Long_Life' -> (['Trickle', ...], 'Standard')."""
    modes, current = [], None
    for tok in text.split():
        if tok.startswith("[") and tok.endswith("]"):
            tok = tok[1:-1]
            current = tok
        modes.append(tok)
    return modes, current


def effect_rgb(cfg, t):
    """Ideal effect color at time t (shared by device writer and UI preview)."""
    base = hex_to_rgb(cfg["color"])
    mode, speed = cfg["mode"], cfg["speed"]
    if mode == "breathing":
        period = 6.5 - speed * 0.45          # 6.05s .. 2.0s
        k = (1 - math.cos(2 * math.pi * t / period)) / 2
        k = 0.08 + 0.92 * k
        return tuple(int(c * k) for c in base)
    if mode == "rainbow":
        rate = 0.02 + speed * 0.02           # revolutions per second
        return tuple(int(c * 255)
                     for c in colorsys.hsv_to_rgb((t * rate) % 1.0, 1.0, 1.0))
    return base


def is_animated(cfg, is_rgb):
    return bool(cfg["on"]) and cfg["mode"] in ("breathing", "rainbow") and is_rgb


class Backlight:
    """sysfs LED device with logind fallback for brightness."""

    def __init__(self):
        self.path = None
        self.name = None
        self.is_rgb = False
        for name in LED_CANDIDATES:
            p = os.path.join("/sys/class/leds", name)
            if os.path.isdir(p):
                self.path = p
                self.name = name
                self.is_rgb = "rgb:" in name
                break
        self.max_brightness = 1
        self.max_intensity = (255, 255, 255)  # tuxedo-drivers: 0..255/channel
        if self.path:
            with open(os.path.join(self.path, "max_brightness")) as f:
                self.max_brightness = int(f.read().strip())
            # uniwill-laptop takes 0..50 per channel and silently clamps
            # larger values, which would wash every color out to white
            try:
                mi = [int(v) for v in read_sysfs(
                    os.path.join(self.path, "multi_max_intensity")).split()]
                if len(mi) == 3 and all(v > 0 for v in mi):
                    self.max_intensity = tuple(mi)
            except (OSError, ValueError):
                pass

    @property
    def found(self):
        return self.path is not None

    def _write(self, attr, value):
        with open(os.path.join(self.path, attr), "w") as f:
            f.write(value)

    def set_brightness(self, value):
        value = max(0, min(self.max_brightness, int(value)))
        try:
            self._write("brightness", str(value))
        except PermissionError:
            # logind grants the active session brightness control without root
            subprocess.run(
                ["busctl", "call", "org.freedesktop.login1",
                 "/org/freedesktop/login1/session/auto",
                 "org.freedesktop.login1.Session", "SetBrightness",
                 "ssu", "leds", self.name, str(value)],
                check=False, capture_output=True)

    def scale_color(self, rgb):
        """0..255 RGB -> the LED's own per-channel intensity range."""
        return tuple(int(round(c * m / 255))
                     for c, m in zip(rgb, self.max_intensity))

    def set_color(self, r, g, b):
        # raises PermissionError for the caller to surface a hint
        if self.is_rgb:
            self._write("multi_intensity",
                        "%d %d %d" % self.scale_color((r, g, b)))


class Writer(threading.Thread):
    """Owns all EC writes. Coalesces to the newest state; runs effect frames.

    UI threads call update(cfg) and never block. One EC write is ~450 ms, so
    intermediate states (slider drags, rapid clicks) are skipped naturally.
    """

    FRAME_GAP = 0.15  # pause between effect frames on top of the write itself

    def __init__(self, backlight, on_perm_error=None):
        super().__init__(daemon=True)
        self.bl = backlight
        self.on_perm_error = on_perm_error
        self.cond = threading.Condition()
        self.cfg = None
        self.dirty = False
        self.running = True
        self.t0 = time.monotonic()
        self._last_brightness = None
        self._last_color = None
        self._perm_reported = False

    def update(self, cfg):
        with self.cond:
            self.cfg = dict(cfg)
            self.dirty = True
            self.cond.notify()

    def stop(self):
        with self.cond:
            self.running = False
            self.cond.notify()

    def _set_brightness(self, v):
        if v != self._last_brightness:
            self.bl.set_brightness(v)
            self._last_brightness = v

    def _set_color(self, rgb):
        # compare in device units: nearby 0..255 colors often map to the same
        # 0..50 intensities, and every skipped write saves ~450 ms of EC time
        scaled = self.bl.scale_color(rgb)
        if scaled != self._last_color:
            self.bl.set_color(*rgb)
            self._last_color = scaled

    def sync_once(self, cfg):
        """Apply non-animated parts of cfg (blocking; used headless too)."""
        if not cfg["on"]:
            self._set_brightness(0)
            return
        self._set_brightness(cfg["brightness"])
        if self.bl.is_rgb and cfg["mode"] == "static":
            self._set_color(hex_to_rgb(cfg["color"]))

    def run(self):
        while True:
            with self.cond:
                while self.running and not self.dirty and \
                        not (self.cfg and is_animated(self.cfg, self.bl.is_rgb)):
                    self.cond.wait()
                if not self.running:
                    return
                cfg = dict(self.cfg)
                self.dirty = False
            try:
                self.sync_once(cfg)
                if is_animated(cfg, self.bl.is_rgb):
                    rgb = effect_rgb(cfg, time.monotonic() - self.t0)
                    self._set_color(rgb)
                    time.sleep(self.FRAME_GAP)
            except PermissionError:
                if not self._perm_reported:
                    self._perm_reported = True
                    if self.on_perm_error:
                        self.on_perm_error()
                time.sleep(1)
            except OSError:
                time.sleep(1)


class Laptop:
    """uniwill-laptop extras: hwmon sensors, charging mode, Fn/Super lock.

    Every attribute is optional; whatever is missing just hides its UI.
    """

    def __init__(self):
        self.temps = []   # (index, label, input path)
        self.fans = []    # (index, label, input path, pwm path | None)
        hw = None
        for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            try:
                if read_sysfs(os.path.join(d, "name")) == UNIWILL_HWMON:
                    hw = d
                    break
            except OSError:
                pass
        if hw:
            for kind in ("temp", "fan"):
                idx = sorted(int(f[len(kind):-6]) for f in os.listdir(hw)
                             if f.startswith(kind) and f.endswith("_input")
                             and f[len(kind):-6].isdigit())
                for i in idx:
                    try:
                        label = read_sysfs(
                            os.path.join(hw, "%s%d_label" % (kind, i)))
                    except OSError:
                        label = None
                    inp = os.path.join(hw, "%s%d_input" % (kind, i))
                    if kind == "temp":
                        self.temps.append((i, label, inp))
                    else:
                        pwm = os.path.join(hw, "pwm%d" % i)
                        self.fans.append((i, label, inp,
                                          pwm if os.path.exists(pwm) else None))
        self.fn_lock = self._attr(UNIWILL_DEV, "fn_lock")
        self.super_key = self._attr(UNIWILL_DEV, "super_key_enable")
        # charging modes come from the driver's battery extension
        self.charge = None
        for bat in sorted(glob.glob("/sys/class/power_supply/BAT*")):
            if os.path.isdir(os.path.join(bat, "extensions", "uniwill")) or \
                    os.path.isdir(UNIWILL_DEV):
                self.charge = self._attr(bat, "charge_types")
                if self.charge:
                    break

    @staticmethod
    def _attr(base, name):
        p = os.path.join(base, name)
        return p if os.path.exists(p) else None

    @property
    def has_sensors(self):
        return bool(self.temps or self.fans)

    @property
    def found(self):
        return bool(self.has_sensors or self.charge or self.fn_lock
                    or self.super_key)

    def read_charge(self):
        modes, cur = parse_charge_types(read_sysfs(self.charge))
        return [m for m in CHARGE_MODES if m in modes], cur

    def snapshot(self):
        """Blocking read of everything (EC-backed, ~100 ms): worker only."""
        d = {"temps": {}, "fans": {}, "controls": {}}
        for i, _label, p in self.temps:
            try:
                d["temps"][i] = int(read_sysfs(p)) / 1000
            except (OSError, ValueError):
                d["temps"][i] = None
        for i, _label, p, pwm in self.fans:
            rpm = duty = None
            try:
                rpm = int(read_sysfs(p))
                if pwm:
                    duty = round(int(read_sysfs(pwm)) * 100 / 255)
            except (OSError, ValueError):
                pass
            d["fans"][i] = (rpm, duty)
        for p in (self.fn_lock, self.super_key, self.charge):
            if p:
                try:
                    d["controls"][p] = read_sysfs(p)
                except OSError:
                    pass
        return d


class AttrWriter(threading.Thread):
    """Serial writer for single-value sysfs settings (EC-backed, may block).

    Coalesces per path to the newest value and reports every result through
    on_done(path, value, error) on the worker thread. A per-path generation
    counter lets readers drop values read while a write was in flight; a
    path also stays "busy" for SETTLE seconds after its write, because the
    EC applies some settings (Super key lock) asynchronously and reads back
    the old value for up to a second.
    """

    SETTLE = 2.5

    def __init__(self, on_done=None):
        super().__init__(daemon=True)
        self.on_done = on_done
        self.cond = threading.Condition()
        self.pending = {}   # path -> value
        self.inflight = None
        self.gen = {}       # path -> counter
        self.done_at = {}   # path -> monotonic time of the last write

    def write(self, path, value):
        with self.cond:
            self.pending[path] = value
            self.gen[path] = self.gen.get(path, 0) + 1
            self.cond.notify()

    def state(self):
        """(generation per path, paths queued or being written)."""
        with self.cond:
            busy = set(self.pending)
            if self.inflight:
                busy.add(self.inflight)
            now = time.monotonic()
            busy.update(p for p, t in self.done_at.items()
                        if now - t < self.SETTLE)
            return dict(self.gen), busy

    def run(self):
        while True:
            with self.cond:
                while not self.pending:
                    self.cond.wait()
                path = next(iter(self.pending))
                value = self.pending.pop(path)
                self.inflight = path
            err = None
            try:
                with open(path, "w") as f:
                    f.write(value)
            except OSError as e:
                err = e
            with self.cond:
                self.gen[path] = self.gen.get(path, 0) + 1
                self.done_at[path] = time.monotonic()
                self.inflight = None
            if self.on_done:
                self.on_done(path, value, err)


class Poller(threading.Thread):
    """Reads sensors and settings every SENSOR_INTERVAL while active.

    The window activates it only while it is visible, so a hidden or
    minimized UniGlow costs no EC reads at all.
    """

    def __init__(self, laptop, attrw, on_data):
        super().__init__(daemon=True)
        self.lp = laptop
        self.attrw = attrw
        self.on_data = on_data
        self.cond = threading.Condition()
        self.active = False
        self.kicked = False

    def set_active(self, on):
        with self.cond:
            if on != self.active:
                self.active = on
                self.cond.notify()

    def kick(self):
        """Read again right away (e.g. after a failed write)."""
        with self.cond:
            self.kicked = True
            self.cond.notify()

    def run(self):
        while True:
            with self.cond:
                while not self.active:
                    self.cond.wait()
                self.kicked = False
            gens = self.attrw.state()[0]
            data = self.lp.snapshot()
            data["gens"] = gens
            self.on_data(data)
            with self.cond:
                if not self.kicked:
                    self.cond.wait(SENSOR_INTERVAL)


def autostart_enabled():
    return os.path.exists(AUTOSTART_PATH)


def set_autostart(enabled):
    if enabled:
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        with open(AUTOSTART_PATH, "w") as f:
            f.write("[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=UniGlow (restore backlight)\n"
                    "Exec=uniglow --apply\n"
                    "X-GNOME-Autostart-enabled=true\n")
    else:
        try:
            os.remove(AUTOSTART_PATH)
        except OSError:
            pass


def run_apply():
    """Headless: apply saved state; stay resident only for animated modes."""
    cfg = load_config()
    bl = Backlight()
    if not bl.found:
        sys.exit(1)
    writer = Writer(bl)
    if not is_animated(cfg, bl.is_rgb):
        try:
            writer.sync_once(cfg)
        except OSError as e:
            print(e, file=sys.stderr)
            sys.exit(1)
        return
    from gi.repository import GLib
    writer.start()
    writer.update(cfg)
    loop = GLib.MainLoop()
    for s in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, s, loop.quit)
    loop.run()


def kill_stray_apply():
    # a resident `--apply` effect process would fight the GUI over the EC
    me = os.getpid()
    out = subprocess.run(["pgrep", "-f", "uniglow --apply"],
                         capture_output=True, text=True).stdout.split()
    for pid in out:
        if pid.isdigit() and int(pid) != me:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass


