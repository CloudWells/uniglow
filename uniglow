        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
        from gi.repository import Adw, Gdk, Gio, GLib, Gtk
        self.Adw, self.Gtk, self.Gdk = Adw, Gtk, Gdk
        self.Gio, self.GLib = Gio, GLib
        self.app = app
        self.cfg = cfg
        self.bl = bl
        self.writer = writer
        self.laptop = laptop
        self.attrw = attrw
        self.poller = poller
        self._last_data = None
        self.sensor_labels = {}
        self.charge_toggles = None
        self.sw_fn = self.sw_super = None
